# ── Database ──────────────────────────────────────────────────────────
DB_PASSWORD=change-me

# ── Authentication ────────────────────────────────────────────────────
# Signs access tokens. Keep this stable across restarts/upgrades — changing it
# invalidates every issued access token. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-string

# Lifetime of an access token. Short by design; the refresh cookie keeps the
# session alive, so there is no reason to raise this.
JWT_EXPIRATION=15m

# How long a session survives without being used. Renewed on every refresh, so
# an actively used session never expires.
JWT_REFRESH_EXPIRATION_DAYS=30

# Marks the refresh cookie Secure. 'auto' follows the request protocol, so
# plain-HTTP LAN access keeps working. Set to 'true' if TLS is terminated by a
# proxy that does not forward X-Forwarded-Proto.
ZAINDARI_COOKIE_SECURE=auto

# ── App settings ──────────────────────────────────────────────────────
# Allow new user registration (true/false)
ZAINDARI_SIGNUP_ENABLED=true

# Bootstrap admin. Only an admin can create another admin, so a fresh install
# would otherwise have no way to reach the admin panel. The account with this
# username is granted admin rights; set it before registering (or before your
# first OIDC login), then leave it in place or clear it once you are set up.
# Leave empty to disable.
ZAINDARI_ADMIN_USERNAME=

# ── Push Notifications ────────────────────────────────────────────────
# Contact info for VAPID (used by push services)
ZAINDARI_VAPID_SUBJECT=mailto:admin@zaindari.local

# ── Timezone ──────────────────────────────────────────────────────────
# The zone every reminder time in this instance is read in. When someone sets
# a reminder for 09:00, this decides which 09:00 they meant, so set it to
# where the people using this install actually live — leaving it at UTC makes
# reminders arrive an offset late (two hours, in Madrid in summer).
# An IANA name; anything the runtime does not recognise stops the server
# rather than quietly falling back to UTC.
TZ=UTC

# ── Network ───────────────────────────────────────────────────────────
# Port exposed on the host
PORT=3000
