{
  "extends": "./tsconfig.json",
  // vitest.config.ts and prisma.config.ts must be excluded: as root-level files
  // they widen the inferred rootDir from src/ to the project root, emitting
  // dist/src/main.js instead of dist/main.js.
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "vitest.config.ts",
    "prisma.config.ts"
  ]
}
