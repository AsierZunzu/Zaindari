{
  "extends": "./tsconfig.json",
  // TypeScript 6 no longer infers rootDir; without it the build refuses to pick
  // an output layout. Pinning it to src/ is what emits dist/main.js rather than
  // dist/src/main.js, and why vitest.config.ts and prisma.config.ts, root-level
  // files outside it, must be excluded.
  "compilerOptions": { "rootDir": "./src" },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "vitest.config.ts",
    "prisma.config.ts"
  ]
}
