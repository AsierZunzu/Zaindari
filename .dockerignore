# ── Dependencies (reinstalled inside the image) ──────────────────────
**/node_modules
**/.npm

# ── Build output (regenerated by the build stages) ───────────────────
**/dist
**/build
**/*.tsbuildinfo
server/static

# ── VCS & editors ────────────────────────────────────────────────────
.git
.gitignore
.idea
.vscode
**/.DS_Store
**/Thumbs.db

# ── Secrets & local config ───────────────────────────────────────────
.env
.env.*
!.env.example

# ── Tests, coverage, CI artifacts ────────────────────────────────────
**/coverage
**/.nyc_output
**/test-results
**/playwright-report
server/test
**/*.spec.ts
**/*.test.ts

# ── Runtime data (bind-mounted volume in compose) ────────────────────
uploads

# ── Docs & Docker meta ───────────────────────────────────────────────
**/*.md
Dockerfile
.dockerignore
compose.yaml
